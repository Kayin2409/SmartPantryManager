<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartPantryManager" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Monochrome Palette -->
        <item name="colorPrimary">@color/mono_black</item>
        <item name="colorOnPrimary">@color/mono_white</item>
        <item name="colorPrimaryContainer">@color/mono_nav_indicator_light</item>
        <item name="colorOnPrimaryContainer">@color/mono_black</item>

        <item name="colorSecondary">#3A3A3C</item>
        <item name="colorOnSecondary">@color/mono_white</item>

        <item name="android:colorBackground">@color/mono_bg_light</item>
        <item name="colorSurface">@color/mono_surface_light</item>
        <item name="colorOnSurface">@color/mono_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/mono_text_secondary</item>
        <item name="colorOutline">@color/mono_card_border</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/mono_bg_light</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Default Card & Button Style -->
        <item name="materialCardViewStyle">@style/Widget.SleekCardView</item>
        <item name="materialButtonStyle">@style/Widget.SleekButton</item>
    </style>

    <style name="Widget.SleekCardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/mono_card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/mono_surface_light</item>
    </style>

    <style name="Widget.SleekButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/mono_black</item>
        <item name="android:textColor">@color/mono_white</item>
    </style>

    <style name="Theme.SmartPantryManager" parent="Base.Theme.SmartPantryManager" />
</resources>
